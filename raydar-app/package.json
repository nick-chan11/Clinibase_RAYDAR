{
  "name": "raydar-app",
  "private": true,
  "version": "2.7.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:single": "vite build --mode single && node scripts/copy-single.mjs",
    "study:report": "node --import ./scripts/tools/lib/register.mjs scripts/tools/study-report.mjs",
    "study:diff": "node --import ./scripts/tools/lib/register.mjs scripts/tools/esource-diff.mjs",
    "study:check-data": "node scripts/tools/check-data.mjs",
    "test:studies": "node scripts/tests/studies.mjs",
    "test:pdf": "node scripts/tests/pdf.mjs",
    "test:offline": "node scripts/tests/offline.mjs",
    "test": "npm run study:check-data && npm run test:studies && npm run test:pdf"
  },
  "dependencies": {
    "jspdf": "^2.5.2",
    "motion": "^12.43.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "vite": "^5.4.21",
    "vite-plugin-singlefile": "2.3"
  }
}
